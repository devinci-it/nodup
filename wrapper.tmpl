#!/usr/bin/env sh

APP_NAME="{{APP_NAME}}"
PROJECT_DIR="{{PROJECT_DIR}}"

# Enable argparse autocomplete
export _ARGCOMPLETE=1
export ARGCOMPLETE_USE_TEMPFILES=1

HINT_FILE="$HOME/.config/$APP_NAME/.autocomplete_hinted"

if [ ! -f "$HINT_FILE" ]; then
    if command -v register-python-argcomplete >/dev/null 2>&1; then
        SHELL_NAME=$(basename "$SHELL")

        echo ""
        echo "💡 Enable tab completion for $APP_NAME:"
        case "$SHELL_NAME" in
            bash)
                echo '   eval "$(register-python-argcomplete {{APP_NAME}})"'
                ;;
            zsh)
                echo '   autoload -U bashcompinit && bashcompinit'
                echo '   eval "$(register-python-argcomplete {{APP_NAME}})"'
                ;;
            *)
                echo '   eval "$(register-python-argcomplete {{APP_NAME}})"'
                ;;
        esac
        echo ""
        echo "Add this to your shell config"
    fi

    mkdir -p "$(dirname "$HINT_FILE")"
    touch "$HINT_FILE"
fi

cd "$PROJECT_DIR"
exec pipenv run {{APP_NAME}} "$@"

