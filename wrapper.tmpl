#!/usr/bin/env bash

# Wrapper Template for Running Commands with Arguments
# Usage: Replace {{PROJECT_DIR}} with the project path and {{EXEC_NAME}} with the executable name

# Define Project Details
PROJECT_DIR="{{PROJECT_DIR}}"
EXEC_NAME="{{EXEC_NAME}}"
# Try to derive the virtual environment path based on pipenv
VENV_PATH=$(cd "$PROJECT_DIR" && pipenv --venv)
EXEC_ABS_PATH="$VENV_PATH/bin/$EXEC_NAME"
# Fallback to looking for the .venv directory inside the project if pipenv venv is not found
if [ ! -d "$VENV_PATH" ]; then
    echo "❌ pipenv virtual environment not found. Looking for .venv directory..."

    # Check if .venv exists in the project directory
    VENV_PATH="$PROJECT_DIR/.venv"
    if [ ! -d "$VENV_PATH" ]; then
        echo "❌ No .venv directory found in $PROJECT_DIR!"
        echo "⚠️ Please ensure you have a virtual environment set up."
        echo "Alternatively, you can manually specify the path to your Python virtual environment's bin directory."
        echo "For example, if you're using a different Python environment, provide the full path to the bin directory."
        exit 1
    fi
fi

# Derive the bin directory inside the virtual environment
VENV_BIN_DIR="$VENV_PATH/bin"

# Check if the executable exists inside the virtual environment's bin directory
if [ ! -f "$VENV_BIN_DIR/$EXEC_NAME" ]; then
    echo "❌ $EXEC_NAME executable not found in virtual environment at $VENV_BIN_DIR."
    exit 1
fi

# Execute the executable with the passed parameters
echo "Executing: $VENV_BIN_DIR/$EXEC_NAME $@"
"$EXEC_ABS_PATH" "$@"
